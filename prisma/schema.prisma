generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── System Roles ───────────────────────────────────────────
enum SystemRole {
  STUDENT
  SUPERVISOR
  ADMIN
}

enum AuthProvider {
  CREDENTIALS
  GITHUB
  GOOGLE
  ORCID
  GUEST
}

// ─── User ───────────────────────────────────────────────────
model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String?
  image        String?
  institution  String?
  department   String?
  role         String?      @default("STUDENT")
  systemRole   SystemRole   @default(STUDENT)
  provider     AuthProvider @default(CREDENTIALS)
  providerId   String?
  isGuest      Boolean      @default(false)
  isActive     Boolean      @default(true)

  // Profile & Social Media Links
  bio              String?      @db.Text
  githubUrl        String?
  linkedinUrl      String?
  googleScholarUrl String?
  orcidUrl         String?
  twitterUrl       String?
  websiteUrl       String?
  huggingFaceUrl   String?
  researchGateUrl  String?

  // Live Calendar Subscription Feed Token (RFC 5545 WebCal / Google Calendar)
  calendarFeedToken String?      @unique @default(cuid())

  // Two-factor, open to any account. Both ways of receiving a code can be set
  // up side by side — `twoFactorSecret` holds the authenticator app's key and
  // `twoFactorEmailReady` records that emailed codes have been proven to
  // arrive. `twoFactorMethod` names the one actually used at sign-in, and
  // `twoFactorEnabled` is true while at least one of them is configured.
  // Administrators are held at /security-setup until it is.
  twoFactorEnabled    Boolean          @default(false)
  twoFactorMethod     TwoFactorMethod?
  twoFactorSecret     String?
  twoFactorEmailReady Boolean          @default(false)

  /// Unused. Kept only so `prisma db push` in the build stays additive —
  /// dropping a populated column makes Prisma refuse, which fails the whole
  /// deploy. Remove it deliberately one day with a one-off
  /// `prisma db push --accept-data-loss`, never as part of a build.
  twoFactorSetupDone  Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Own data
  papers      Paper[]
  collections Collection[]
  tags        Tag[]
  notes       Note[]

  // Supervisor ↔ Student relationship
  supervisorId String?
  supervisor   User?   @relation("SupervisorStudents", fields: [supervisorId], references: [id])
  students     User[]  @relation("SupervisorStudents")

  // Paper assignments
  assignedPapers  Assignment[] @relation("AssignedTo")
  assignmentsMade Assignment[] @relation("AssignedBy")

  // Feedback
  feedbackGiven    Feedback[] @relation("FeedbackAuthor")
  feedbackReceived Feedback[] @relation("FeedbackTarget")

  // Notifications
  notifications Notification[]

  // 1-on-1 Meetings
  meetingsAsSupervisor Meeting[] @relation("SupervisorMeetings")
  meetingsAsStudent    Meeting[] @relation("StudentMeetings")

  // Review Rubrics
  rubricsGiven    ReviewRubric[] @relation("RubricSupervisor")
  rubricsReceived ReviewRubric[] @relation("RubricStudent")

  // Thesis Milestones
  milestonesAsStudent    ThesisMilestone[] @relation("StudentMilestones")
  milestonesAsSupervisor ThesisMilestone[] @relation("SupervisorMilestones")

  // Academic Labs & Research Groups
  labsLed              Lab[]                @relation("LabLead")
  labMemberships       LabMember[]
  groupMemberships     GroupMember[]
  labJoinRequests      LabJoinRequest[]
  broadcastsAuthored   LabBroadcast[]
  journalClubSessions  JournalClubSession[]
  hostedLabMeetings    LabMeeting[]         @relation("HostLabMeetings")
  pushSubscriptions    PushSubscription[]
  assignedLabTasks     LabTask[]            @relation("AssignedLabTasks")
  createdLabTasks      LabTask[]            @relation("CreatedLabTasks")
  sharedPapersSent     PaperShare[]         @relation("SharedPapersBy")
  sharedPapersReceived PaperShare[]         @relation("SharedPapersWith")

  // Role change requests (student ↔ supervisor), decided by an admin
  roleRequests         RoleChangeRequest[] @relation("RoleRequester")
  roleRequestsReviewed RoleChangeRequest[] @relation("RoleReviewer")

  // Supervision requests (Supervisor claims student, student accepts/rejects)
  supervisionRequestsSent     SupervisionRequest[] @relation("SupervisorRequestsSent")
  supervisionRequestsReceived SupervisionRequest[] @relation("StudentRequestsReceived")

  // Highlights & Marginal Annotations
  highlights        Highlight[]        @relation("UserHighlights")
  highlightComments HighlightComment[] @relation("UserHighlightComments")
}

// ─── Paper ──────────────────────────────────────────────────
model Paper {
  id     String  @id @default(cuid())
  slug   String? @unique
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  title           String
  authors         String
  abstract        String?  @db.Text
  doi             String?
  url             String?
  journal         String?
  publicationYear Int?
  status          Status   @default(TO_READ)
  priority        Priority @default(MEDIUM)
  isFavorite      Boolean  @default(false)
  pdfPath         String?
  arxivId         String?
  citationCount   Int?     @default(0)

  // AI & ML Research Specific Fields
  codeUrl           String?
  modelUrl          String?
  datasetUrl        String?
  weightsUrl        String?
  studentRepoUrl    String?
  notebookUrl       String?
  hardwareSpecs     String?
  replicationNotes  String? @db.Text
  replicationChecklist String? @db.Text
  replicationStatus ReplicationStatus @default(UNTESTED)

  // Model Architecture & Compute Specs
  parameters    String?
  contextWindow String?
  architecture  String?
  computeBudget String?
  benchmarks    String? @db.Text

  // 3-Minute Digest & Core Synthesis
  problemSolved   String? @db.Text
  keyContribution String? @db.Text
  limitations     String? @db.Text

  // Literature Review Matrix & Collaborative Annotations
  literatureReview String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags                Tag[]                @relation("PaperTags")
  collections         Collection[]         @relation("PaperCollections")
  notes               Note[]
  highlights          Highlight[]
  assignments         Assignment[]
  feedback            Feedback[]
  rubrics             ReviewRubric[]
  starterPackItems    StarterPackItem[]
  journalClubSessions JournalClubSession[]
  shares              PaperShare[]

  @@unique([userId, doi])
}

// ─── Highlight & Marginal Annotation ────────────────────────
model Highlight {
  id          String   @id @default(cuid())
  paperId     String
  paper       Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("UserHighlights", fields: [userId], references: [id], onDelete: Cascade)
  
  text        String   @db.Text
  color       String   @default("YELLOW") // "YELLOW" | "GREEN" | "ROSE" | "PURPLE"
  category    String   @default("METHODOLOGY") // "METHODOLOGY" | "CONTRIBUTION" | "LIMITATION" | "FEEDBACK"
  pageNumber  Int?     @default(1)
  position    String?  @db.Text
  isPrivate   Boolean  @default(false)
  
  comments    HighlightComment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([paperId])
  @@index([userId])
}

model HighlightComment {
  id          String    @id @default(cuid())
  highlightId String
  highlight   Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("UserHighlightComments", fields: [userId], references: [id], onDelete: Cascade)
  content     String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([highlightId])
  @@index([userId])
}

// ─── PaperShare (Peer Student / Colleague Sharing) ───────────
model PaperShare {
  id           String   @id @default(cuid())
  paperId      String
  paper        Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  sharedById   String
  sharedBy     User     @relation("SharedPapersBy", fields: [sharedById], references: [id], onDelete: Cascade)
  sharedWithId String
  sharedWith   User     @relation("SharedPapersWith", fields: [sharedWithId], references: [id], onDelete: Cascade)
  permission   String   @default("VIEW") // "VIEW" | "COMMENT"
  note         String?  @db.Text
  createdAt    DateTime @default(now())

  @@unique([paperId, sharedWithId])
}

// ─── Assignment (Supervisor → Student) ──────────────────────
model Assignment {
  id               String           @id @default(cuid())
  paperId          String
  paper            Paper            @relation(fields: [paperId], references: [id], onDelete: Cascade)
  studentId        String
  student          User             @relation("AssignedTo", fields: [studentId], references: [id])
  assignedById     String
  assignedBy       User             @relation("AssignedBy", fields: [assignedById], references: [id])
  dueDate          DateTime?
  status           AssignmentStatus @default(PENDING)
  note             String?          @db.Text
  literatureReview String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([paperId, studentId])
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

// ─── Feedback (Supervisor comments on student work) ─────────
model Feedback {
  id           String       @id @default(cuid())
  content      String       @db.Text
  paperId      String
  paper        Paper        @relation(fields: [paperId], references: [id], onDelete: Cascade)
  authorId     String
  author       User         @relation("FeedbackAuthor", fields: [authorId], references: [id])
  targetUserId String
  targetUser   User         @relation("FeedbackTarget", fields: [targetUserId], references: [id])
  type         FeedbackType @default(COMMENT)
  createdAt    DateTime     @default(now())
}

enum FeedbackType {
  COMMENT
  SUGGESTION
  APPROVAL
  REVISION_REQUEST
}

// ─── Tag ────────────────────────────────────────────────────
model Tag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name   String
  papers Paper[] @relation("PaperTags")

  @@unique([userId, name])
}

// ─── Collection ─────────────────────────────────────────────
model Collection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  color       String?
  papers      Paper[]  @relation("PaperCollections")
  createdAt   DateTime @default(now())

  @@unique([userId, name])
}

// ─── Note ───────────────────────────────────────────────────
model Note {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  content   String   @db.Text
  isPrivate Boolean  @default(false)
  paperId   String
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Enums ──────────────────────────────────────────────────
enum Status {
  TO_READ
  READING
  COMPLETED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReplicationStatus {
  UNTESTED
  VERIFIED_RUNNABLE
  MISSING_WEIGHTS
  DATASET_UNAVAILABLE
  ABLATION_REPLICATED
  FAILED
  REPRODUCING
  REPLICATED
}

// ─── Notification (Real-Time Lab Alerts) ───────────────────
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String           @db.Text
  type      NotificationType @default(ASSIGNMENT)
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

enum NotificationType {
  ASSIGNMENT
  FEEDBACK
  STATUS_UPDATE
  SYSTEM
}

// ─── AuditLog (Lab Governance & Forensic Trail) ────────────
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  resource  String
  details   String?  @db.Text
  severity  String   @default("INFO") // INFO, WARNING, CRITICAL
  createdAt DateTime @default(now())
}

// ─── Weekly 1-on-1 Meeting & Action Item Hub ──────────────
model Meeting {
  id              String        @id @default(cuid())
  supervisorId    String
  supervisor      User          @relation("SupervisorMeetings", fields: [supervisorId], references: [id])
  studentId       String
  student         User          @relation("StudentMeetings", fields: [studentId], references: [id])
  title           String
  scheduledAt     DateTime
  status          MeetingStatus @default(SCHEDULED)
  studentNotes    String?       @db.Text
  supervisorNotes String?       @db.Text
  actionItems     String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// ─── Faculty Review Rubric & Conference Scorecard ─────────
model ReviewRubric {
  id               String        @id @default(cuid())
  paperId          String
  paper            Paper         @relation(fields: [paperId], references: [id], onDelete: Cascade)
  supervisorId     String
  supervisor       User          @relation("RubricSupervisor", fields: [supervisorId], references: [id])
  studentId        String
  student          User          @relation("RubricStudent", fields: [studentId], references: [id])
  problemScore     Int           @default(3) // 1-5
  methodologyScore Int           @default(3) // 1-5
  empiricalScore   Int           @default(3) // 1-5
  synthesisScore   Int           @default(3) // 1-5
  verdict          RubricVerdict @default(APPROVED)
  feedbackSummary  String?       @db.Text
  createdAt        DateTime      @default(now())
}

enum RubricVerdict {
  APPROVED
  MINOR_REVISION
  MAJOR_REVISION
}

// ─── Thesis & Research Milestone Tracker ──────────────────
model ThesisMilestone {
  id               String          @id @default(cuid())
  studentId        String
  student          User            @relation("StudentMilestones", fields: [studentId], references: [id])
  supervisorId     String
  supervisor       User            @relation("SupervisorMilestones", fields: [supervisorId], references: [id])
  title            String
  description      String          @db.Text
  dueDate          DateTime?
  status           MilestoneStatus @default(PENDING)
  deliverableUrl   String?
  deliverableNotes String?         @db.Text
  collectionId     String?
  feedback         String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
}

// ─── Academic Research Lab ──────────────────────────────────
model Lab {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  joinCode     String           @unique
  institution  String
  department   String?
  description  String?          @db.Text
  leadId       String
  lead         User             @relation("LabLead", fields: [leadId], references: [id])
  members      LabMember[]
  groups       ResearchGroup[]
  joinRequests LabJoinRequest[]
  broadcasts   LabBroadcast[]
  meetings     LabMeeting[]
  tasks        LabTask[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// ─── Lab Membership & Roles ─────────────────────────────────
model LabMember {
  id       String   @id @default(cuid())
  labId    String
  lab      Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     LabRole  @default(RESEARCHER) // LEAD, CO_LEAD, RESEARCHER, GUEST
  joinedAt DateTime @default(now())

  @@unique([labId, userId])
}

enum LabRole {
  LEAD
  CO_LEAD
  RESEARCHER
  GUEST
}

// ─── Research Sub-Groups & Project Clusters ─────────────────
model ResearchGroup {
  id                  String               @id @default(cuid())
  labId               String
  lab                 Lab                  @relation(fields: [labId], references: [id], onDelete: Cascade)
  name                String
  description         String?              @db.Text
  color               String               @default("cyan")
  members             GroupMember[]
  starterPackItems    StarterPackItem[]
  journalClubSessions JournalClubSession[]
  meetings            LabMeeting[]
  tasks               LabTask[]
  broadcasts          LabBroadcast[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

// ─── Group Membership ───────────────────────────────────────
model GroupMember {
  id       String        @id @default(cuid())
  groupId  String
  group    ResearchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String        @default("MEMBER") // LEAD, MEMBER
  joinedAt DateTime      @default(now())

  @@unique([groupId, userId])
}

// ─── Lab Join Requests ──────────────────────────────────────
model LabJoinRequest {
  id        String        @id @default(cuid())
  labId     String
  lab       Lab           @relation(fields: [labId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    RequestStatus @default(PENDING) // PENDING, APPROVED, REJECTED
  message   String?
  createdAt DateTime      @default(now())

  @@unique([labId, userId])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Role Change Request (Student ↔ Supervisor, admin-approved) ───
model RoleChangeRequest {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation("RoleRequester", fields: [userId], references: [id], onDelete: Cascade)
  currentRole   SystemRole
  requestedRole SystemRole
  reason        String?       @db.Text
  status        RequestStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?     @relation("RoleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

// ─── Supervision Request (Supervisor → Student Claim/Invite) ───
model SupervisionRequest {
  id           String        @id @default(cuid())
  supervisorId String
  supervisor   User          @relation("SupervisorRequestsSent", fields: [supervisorId], references: [id], onDelete: Cascade)
  studentId    String
  student      User          @relation("StudentRequestsReceived", fields: [studentId], references: [id], onDelete: Cascade)
  status       RequestStatus @default(PENDING) // PENDING, APPROVED, REJECTED
  message      String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([supervisorId, studentId])
  @@index([studentId, status])
  @@index([supervisorId, status])
}

// ─── Lab Broadcast / Announcement ───────────────────────────
model LabBroadcast {
  id        String         @id @default(cuid())
  labId     String
  lab       Lab            @relation(fields: [labId], references: [id], onDelete: Cascade)
  groupId   String?
  group     ResearchGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id])
  title     String
  content   String         @db.Text
  category  String         @default("ANNOUNCEMENT") // CONFERENCE_DEADLINE, PAPER_ACCEPTED, COMPUTE_NOTICE, ANNOUNCEMENT
  deadline  DateTime? // Optional conference deadline for countdown
  isPinned  Boolean        @default(false)
  createdAt DateTime       @default(now())
}

// ─── Sub-Group Starter Pack (Onboarding Syllabus) ────────────
model StarterPackItem {
  id        String        @id @default(cuid())
  groupId   String
  group     ResearchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paperId   String
  paper     Paper         @relation(fields: [paperId], references: [id], onDelete: Cascade)
  order     Int           @default(0)
  note      String?
  createdAt DateTime      @default(now())

  @@unique([groupId, paperId])
}

// ─── Sub-Group Journal Club Seminar ─────────────────────────
model JournalClubSession {
  id          String        @id @default(cuid())
  groupId     String
  group       ResearchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paperId     String
  paper       Paper         @relation(fields: [paperId], references: [id], onDelete: Cascade)
  presenterId String
  presenter   User          @relation(fields: [presenterId], references: [id])
  scheduledAt DateTime
  status      String        @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  meetingUrl  String?
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
}

// ─── Lab & Sub-Group Meeting Scheduler ──────────────────────
model LabMeeting {
  id          String         @id @default(cuid())
  labId       String
  lab         Lab            @relation(fields: [labId], references: [id], onDelete: Cascade)
  groupId     String? // null = Lab-wide meeting; set = Specific sub-group meeting
  group       ResearchGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  hostId      String
  host        User           @relation("HostLabMeetings", fields: [hostId], references: [id])
  title       String
  description String?        @db.Text
  meetingType String         @default("LAB_WIDE") // LAB_WIDE, SUB_GROUP, SYNC, PRESENTATION, DEFENSE
  startTime   DateTime
  endTime     DateTime?
  location    String? // Physical room or hall
  meetingUrl  String? // Zoom, Google Meet, Microsoft Teams URL
  agenda      String?        @db.Text
  status      String         @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// ─── Web Push Notification Subscription ─────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── Lab Research Tasks & Deliverables ──────────────────────
model LabTask {
  id      String         @id @default(cuid())
  labId   String
  lab     Lab            @relation(fields: [labId], references: [id], onDelete: Cascade)
  groupId String?
  group   ResearchGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  title       String
  description String? @db.Text
  category    String  @default("RESEARCH") // RESEARCH, EXPERIMENT, CODING, WRITING, DATASET, PRESENTATION, REVIEW, OTHER
  priority    String  @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status      String  @default("TODO") // TODO, IN_PROGRESS, IN_REVIEW, COMPLETED

  dueDate DateTime?

  assigneeId String?
  assignee   User?   @relation("AssignedLabTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("CreatedLabTasks", fields: [createdById], references: [id])

  deliverableUrl String?
  progressNotes  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId])
  @@index([assigneeId])
  @@index([groupId])
}

// ─── Admin Two-Factor Verification ──────────────────────────
enum TwoFactorMethod {
  APP
  EMAIL
}

// ─── Password Reset Codes ───────────────────────────────────
model PasswordResetOtp {
  id        String   @id @default(cuid())
  userId    String
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
}

model TwoFactorOtp {
  id        String   @id @default(cuid())
  userId    String
  email     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
}

// ─── "How to Use" Tutorial Videos ───────────────────────────
// An administrator uploads a video to YouTube, then pastes the link here.
// Students and supervisors watch it from the sidebar's How to Use page.
enum HelpAudience {
  ALL
  STUDENT
  SUPERVISOR
}

model HelpVideo {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  /// The link exactly as the administrator pasted it (watch, youtu.be, shorts…).
  youtubeUrl  String
  /// The 11-character YouTube id parsed out of `youtubeUrl` — what the player embeds.
  videoId     String
  audience    HelpAudience @default(ALL)
  /// Lower numbers show first.
  sortOrder   Int          @default(0)
  isPublished Boolean      @default(true)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([audience, isPublished])
}
